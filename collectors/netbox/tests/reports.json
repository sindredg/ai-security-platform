      {"method": "POST", "path": "/api/dcim/devices/", "status": 403}
    ]
  },
  "configured": {
    "check": "configured",
    "accounts": {
      "inventory-reader": {
        "verdict": "excess",
        "reasons": [
          {"kind": "excess", "why": "view on dcim.device without a constraint (inventory-reader-legacy)"}
        ],
        "permissions": [
          {
            "id": 3,
            "name": "inventory-reader-tenant-a",
            "object_types": ["dcim.device", "ipam.ipaddress"],
            "actions": ["view"],
            "constraints": {"tenant__slug": "tenant-a"},
            "via": "user"
          },
          {
            "id": 4,
            "name": "inventory-reader-legacy",
            "object_types": ["dcim.device", "ipam.ipaddress"],
            "actions": ["view"],
            "constraints": null,
            "via": "group inventory-readers"
          }
        ]
      },
      "inventory-reader-control": {
        "verdict": "within",
        "reasons": [],
        "permissions": [
          {
            "id": 5,
            "name": "inventory-reader-control-tenant-a",
            "object_types": ["dcim.device", "ipam.ipaddress"],
            "actions": ["view"],
            "constraints": {"tenant__slug": "tenant-a"},
            "via": "user"
          }
        ]
      }
    }
  },
  "observed": {
    "check": "observed",
    "accounts": {
      "inventory-reader": {
        "verdict": "excess",
        "reasons": [{"kind": "excess", "why": "/api/dcim/devices/: b-fw-01"}],
        "reads": {
          "/api/dcim/devices/": ["a-fw-01", "a-sw-01", "b-fw-01"],
          "/api/ipam/ip-addresses/": ["172.16.1.1/24", "172.16.2.1/24"]
