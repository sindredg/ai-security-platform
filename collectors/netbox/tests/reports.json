      {"object_type": "ipam.ipaddress", "action": "view", "constraints": {"tenant__slug": "tenant-a"}}
    ],
    "reads": [
      {
        "path": "/api/dcim/devices/",
        "key": "name",
        "fields": ["id", "name", "status", "tenant"],
        "records": ["a-fw-01", "a-sw-01"]
      },
      {
        "path": "/api/ipam/ip-addresses/",
        "key": "address",
        "fields": ["id", "address", "tenant"],
        "records": ["172.16.1.1/24"]
      }
    ],
    "denials": [
