        "denials": [
          {"method": "GET", "path": "/api/dcim/sites/", "status": 403},
          {"method": "POST", "path": "/api/dcim/devices/", "status": 403}
        ]
      },
      "inventory-reader-control": {
        "verdict": "within",
        "reasons": [],
        "reads": {
          "/api/dcim/devices/": ["a-fw-01", "a-sw-01"],
          "/api/ipam/ip-addresses/": ["172.16.1.1/24"]
        },
        "denials": [
          {"method": "GET", "path": "/api/dcim/sites/", "status": 403},
          {"method": "POST", "path": "/api/dcim/devices/", "status": 403}
        ]
