# Pins shared by the agent runtime scripts. The checksum of the download is in
# artifacts.tsv.

# Goose. The release has one static binary per platform. The musl build needs
# nothing from the worker's own libraries.
GOOSE_VERSION=1.54.0
GOOSE_ARCHIVE=goose-aarch64-unknown-linux-musl.tar.gz
# The binary inside that archive, read from it after its checksum matched
# artifacts.tsv. G.1 compares the installed binary with it.
GOOSE_BINARY_SHA256=9a71686262c8a65780e325fd92bff1fb0bf2a5bec6d7052de2f810dcd6354fc1

# Where things live on the worker.
GOOSE_DIR=/opt/aisec/goose/goose-$GOOSE_VERSION
FIXTURE_DIR=/opt/aisec/agent-fixture

# The model server the agent talks to, and the name it serves its model under.
MODEL_URL=http://127.0.0.1:8080
MODEL_ALIAS=local
