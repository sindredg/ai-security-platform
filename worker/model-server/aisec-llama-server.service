# The model server. One model, one slot, reachable from this machine only.
# install-server.sh fills in the two paths from pins.env.
[Unit]
Description=llama.cpp model server, localhost only
After=network.target

[Service]
ExecStart=@LLAMA_DIR@/llama-server \
  --model @MODEL_FILE@ \
  --alias local \
  --host 127.0.0.1 --port 8080 \
  --threads 2 --threads-batch 2 \
  --ctx-size 8192 --parallel 1 --cache-ram 0 \
  --no-ui --offline
Restart=on-failure
RestartSec=5

# The server parses a model file and every prompt. It gets a throwaway account,
# a read-only file system, and no address beyond localhost.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
IPAddressAllow=localhost
UMask=0077

# One loaded model has to leave room for the agent on an 8 GiB machine.
MemoryAccounting=yes
MemoryMax=6G

[Install]
WantedBy=multi-user.target
