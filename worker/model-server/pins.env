# Pins shared by the model server scripts. Checksums of downloaded files are in
# artifacts.tsv.

# llama.cpp v0.7.0, the newest stable release. The release itself carries no
# binaries: its tag points at the commit of build b11669, whose tag has them.
# The commit is the same tree, and is where the converter comes from.
LLAMA_BUILD=b11669
LLAMA_COMMIT=620d2225cc436ab0b001e3200e590e3b286ef9ab
# The converter's source, as fetch.sh packs it from that commit with git
# archive. Computed with git 2.43 on 2026-10-19, which also gives the pin of
# the commit before, so the packing has not changed. A git release that packs
# it differently fails fetch.sh, and needs a new pin here.
CONVERTER_SRC_SHA256=f0a5cfc2e809c4e235dfd19d1596a7b55c91444f2db41c5a781e9c13b4b1900c

# The model, and the quantization llama-quantize applies to it.
MODEL_NAME=Qwen3.5-4B
MODEL_QUANT=Q4_K_M

# Where things live on the worker.
LLAMA_DIR=/opt/aisec/llama.cpp/llama-$LLAMA_BUILD
MODEL_DIR=/opt/aisec/models
MODEL_FILE=$MODEL_DIR/$MODEL_NAME-$MODEL_QUANT.gguf
