# Pins shared by the model server scripts. Checksums of downloaded files are in
# artifacts.tsv.

# llama.cpp. The build tag has prebuilt binaries. The commit is the same tree,
# and is where the converter comes from.
LLAMA_BUILD=b11429
LLAMA_COMMIT=d81235049384534c167caea52b85a694f6103d14
# The converter's source, as fetch.sh packs it from that commit with git
# archive. The same bytes came from git 2.43 and git 2.53 on 2026-10-16. A git
# release that packs it differently fails fetch.sh, and needs a new pin here.
CONVERTER_SRC_SHA256=cd546e251a8052c0e1126abd01ac75705dcffa5fc1ad42ca97da546472bde9f0

# The model, and the quantization llama-quantize applies to it.
MODEL_NAME=Qwen3.5-4B
MODEL_QUANT=Q4_K_M

# Where things live on the worker.
LLAMA_DIR=/opt/aisec/llama.cpp/llama-$LLAMA_BUILD
MODEL_DIR=/opt/aisec/models
MODEL_FILE=$MODEL_DIR/$MODEL_NAME-$MODEL_QUANT.gguf
