{
  "listeners": {
    "bind": "0.0.0.0",
    "tls_name": "tool-service.aisec.internal",
    "tool_port": 8443,
    "register_port": 8444
  },
  "registration_caller": {
    "issuer": "https://kubernetes.default.svc.cluster.local",
    "audience": "aisec-tool-service",
    "subject": "system:serviceaccount:orchestration:dispatch"
  },
  "limits": {
    "request_bytes": 8192,
    "result_bytes": 16384,
    "calls_per_job": 20
  },
  "targets": {
    "synthetic": {
      "tools": [
        "get_evidence"
      ]
    }
  },
  "tools": {
    "get_evidence": {
      "description": "Return one stored piece of evidence by its reference.",
      "input_schema": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string",
            "pattern": "^ev-[0-9]{4}(?![\\s\\S])",
            "description": "Evidence reference, for example ev-0001"
          }
        },
        "required": [
          "reference"
        ],
        "additionalProperties": false
      }
    }
  },
  "message_schema": {
    "type": "object",
    "required": [
      "method"
    ],
    "properties": {
      "method": {
        "enum": [
          "server/discover",
          "initialize",
          "notifications/initialized",
          "ping",
          "tools/list",
          "tools/call"
        ]
      }
    },
    "if": {
      "properties": {
        "method": {
          "const": "tools/call"
        }
      }
    },
    "then": {
      "required": [
        "params"
      ],
      "properties": {
        "params": {
          "type": "object",
          "required": [
            "name",
            "arguments"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "arguments": {
              "type": "object"
            }
          }
        }
      }
    }
  },
  "registration_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "job",
      "target",
      "tools",
      "seconds",
      "token_sha256"
    ],
    "properties": {
      "job": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,62}(?![\\s\\S])"
      },
      "target": {
        "type": "string"
      },
      "tools": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string"
        }
      },
      "seconds": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1800
      },
      "token_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
      }
    }
  }
}
