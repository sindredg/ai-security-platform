# Copies the tool service's audit lines into /var/log/aisec/tool-audit.jsonl
# (ADR 0019). A fixed account, not a dynamic one: the default ACL on the pod
# logs and the group of the output file both name it.
[Unit]
Description=Copy the tool service's audit lines to an append-only file
After=k3s.service

[Service]
ExecStart=/usr/bin/python3 -I /usr/local/lib/aisec/aisec_audit_copy.py
User=aisec-audit-copy
Group=aisec-audit-copy
StateDirectory=aisec-audit-copy
StateDirectoryMode=0750
# Exit status 3 is a full file. It stays failed until someone archives it.
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=3

# The lines it reads are shaped by the worker. No network, no capability, and
# nothing writable but its state and the log folder.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/log/aisec
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
UMask=0077

MemoryAccounting=yes
MemoryMax=256M

[Install]
WantedBy=multi-user.target
