# Pulls the worker's journal into /var/log/aisec/worker-journal.jsonl
# (ADR 0019). Started by aisec-journal-pull.timer. A fixed account, because
# the output file's group and the key's owner both name it.
[Unit]
Description=Pull the worker's journal into an append-only file

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /usr/local/lib/aisec/aisec_journal_pull.py
User=aisec-journal-pull
Group=aisec-journal-pull
StateDirectory=aisec-journal-pull
StateDirectoryMode=0700
# A worker that stops sending blocks the read. This ends it.
TimeoutStartSec=180

# What it reads comes from the machine the design assumes is compromised. One
# connection, to the worker on 22, no capability, and nothing writable but its
# state and the log folder.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/log/aisec
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=10.40.0.36
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

MemoryAccounting=yes
MemoryMax=256M
