# Argo Workflows (ADR 0029), read from the project's release page on
# 2026-10-19. The images are pinned in argo.yaml, each digest's cosign
# signature checked against the release's public key before it was pinned.
ARGO_VERSION=v4.1.5
# The release's namespaced install. install.sh applies only its custom
# resource definitions: argo.yaml holds the controller. The checksum is the
# asset's digest as the release lists it.
ARGO_INSTALL_URL=https://github.com/argoproj/argo-workflows/releases/download/v4.1.5/namespace-install.yaml
ARGO_INSTALL_SHA256=02427502f17e98de5fdfb8028523978e86f5481070645d84f991b6d31388bd51
