# Copy to terraform.tfvars. The copy is ignored by Git.
# Leave this out for the first apply. Set it once the target root has created
# its network: terraform -chdir=../targets output -raw virtual_network_id
# targets_virtual_network_id = "REPLACE_WITH_TARGET_VIRTUAL_NETWORK_ID"

# The operator's SSH public key, the one line from the .pub file.
operator_ssh_public_key = "REPLACE_WITH_SSH_PUBLIC_KEY"
# Public half of the SSH certificate authority that signs operator logins.
operator_user_ca_public_key = "REPLACE_WITH_SSH_CA_PUBLIC_KEY"

# The mesh VPN auth key does not go in this file. Export it for the one apply
# that builds the orchestrator:
#   export TF_VAR_tailscale_auth_key='REPLACE_WITH_AUTH_KEY'
