#cloud-config
# First boot of the orchestrator: K3s. Everything fetched here is either a
# signed package or checked against a pinned checksum before it runs. The
# orchestrator is not on the mesh VPN: operator sessions reach it through the
# router (ADR 0025). Its only way out is Squid on the edge, so the operator
# opens a fetch window on the edge before a rebuild (ADR 0020).
write_files:
  - path: /etc/hosts
    append: true
    content: |
      ${worker_ip} aisec-worker

  # Packages come through Squid on the edge, which forwards to this host's
  # package mirror. Unattended upgrades use it too.
  - path: /etc/apt/apt.conf.d/90aisec-proxy
    permissions: "0644"
    content: |
      Acquire::http::Proxy "http://${edge_ip}:3128";

  # Everything else the operator fetches, and git and curl in the fetch
  # scripts, goes through the same proxy. It forwards only while a fetch
  # window is open. Nothing here resolves a public name.
  - path: /etc/environment
    append: true
    content: |
      http_proxy=http://${edge_ip}:3128
      https_proxy=http://${edge_ip}:3128
      no_proxy=localhost,127.0.0.1,${platform_address_space},aisec-worker

  # Pods reach other pods, and nothing else through this host. A pod's network
  # policy is written by kube-router after the pod starts, so this rule holds
  # the first seconds, and CoreDNS's queries to Azure DNS (ADR 0018). It runs
  # after the iptables FORWARD chain, where kube-router refuses first.
  # On the host itself, pods reach the API server and the kubelet, and nothing
  # else (ADR 0023). A pod that needs another host port gets a line here.
  # 10.42.0.0/16 is K3s's default cluster network, which this cluster uses.
  - path: /etc/aisec/pod-egress.nft
    permissions: "0644"
    content: |
      table inet aisec_pod_egress
      delete table inet aisec_pod_egress
      table inet aisec_pod_egress {
        chain forward {
          type filter hook forward priority filter + 10; policy accept;
          ip saddr 10.42.0.0/16 ct state established,related accept
          ip saddr 10.42.0.0/16 ip daddr 10.42.0.0/16 accept
          ip saddr 10.42.0.0/16 counter drop
        }
        chain input {
          type filter hook input priority filter + 10; policy accept;
          ip saddr 10.42.0.0/16 ct state established,related accept
          ip saddr 10.42.0.0/16 tcp dport { 6443, 10250 } accept
          ip saddr 10.42.0.0/16 counter drop
        }
      }

  - path: /etc/systemd/system/aisec-pod-egress.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Keep pods off the internet
      Before=k3s.service

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/usr/sbin/nft -f /etc/aisec/pod-egress.nft

      [Install]
      WantedBy=multi-user.target

  # Hardening that an audit asked for and nothing here needs otherwise. What was
  # left alone, and why, is in the milestone 2 worklog.
  - path: /etc/sysctl.d/90-aisec-hardening.conf
    permissions: "0644"
    content: |
      kernel.sysrq = 0
      kernel.kptr_restrict = 2
      kernel.core_uses_pid = 1
      fs.suid_dumpable = 0
      fs.protected_fifos = 2
      fs.protected_regular = 2
      net.core.bpf_jit_harden = 2
      net.ipv4.conf.all.accept_source_route = 0
      net.ipv4.conf.default.accept_source_route = 0
      net.ipv4.conf.all.accept_redirects = 0
      net.ipv4.conf.default.accept_redirects = 0
      net.ipv4.conf.all.send_redirects = 0
      net.ipv4.conf.default.send_redirects = 0
      net.ipv4.conf.all.log_martians = 1
      net.ipv4.conf.default.log_martians = 1
      net.ipv6.conf.all.accept_redirects = 0
      net.ipv6.conf.default.accept_redirects = 0

  # Read before the image's own files, and the first value wins.
  - path: /etc/ssh/sshd_config.d/10-aisec.conf
    permissions: "0600"
    content: |
      PermitRootLogin no
      AllowAgentForwarding no
      AllowTcpForwarding no
      X11Forwarding no
      MaxAuthTries 3
      MaxSessions 2
      ClientAliveInterval 300
      ClientAliveCountMax 2
      TCPKeepAlive no
      LogLevel VERBOSE
      # The administrator account takes only a certificate signed by the
      # operator's certificate authority, for the principal in the file (ADR
      # 0022). A plain key, the operator's included, is refused. First boot
      # writes the empty revocation list. Other accounts keep their keys.
      Match User ${admin_username}
        AuthorizedKeysFile none
        TrustedUserCAKeys /etc/ssh/aisec-user-ca.pub
        AuthorizedPrincipalsFile /etc/ssh/aisec-principals
        RevokedKeys /etc/ssh/aisec-revoked.krl
        # The one tunnel: kubectl from the operator to the API server on
        # loopback. Every other account keeps AllowTcpForwarding no.
        AllowTcpForwarding local
        PermitOpen 127.0.0.1:6443

  - path: /etc/ssh/aisec-user-ca.pub
    permissions: "0644"
    content: |
      ${operator_user_ca_public_key}

  - path: /etc/ssh/aisec-principals
    permissions: "0644"
    content: |
      aisec-operator

  - path: /etc/modprobe.d/aisec-unused.conf
    permissions: "0644"
    content: |
      install dccp /bin/false
      install sctp /bin/false
      install rds /bin/false
      install tipc /bin/false
      install usb-storage /bin/false

  # Kernel settings the kubelet expects when protect-kernel-defaults is on.
  - path: /etc/sysctl.d/90-aisec-kubelet.conf
    permissions: "0644"
    content: |
      vm.panic_on_oom = 0
      vm.overcommit_memory = 1
      kernel.panic = 10
      kernel.panic_on_oops = 1

  - path: /etc/rancher/k3s/config.yaml
    permissions: "0600"
    content: |
      node-ip: ${orchestrator_ip}
      tls-san:
        - ${orchestrator_ip}
      write-kubeconfig-mode: "0600"
      secrets-encryption: true
      protect-kernel-defaults: true
      disable:
        - traefik
        - servicelb
      # Node ports answer on the private address only, not on loopback. The
      # tool service's port to the worker is one.
      kube-proxy-arg:
        - nodeport-addresses=${orchestrator_ip}/32
      kube-apiserver-arg:
        - audit-log-path=/var/lib/rancher/k3s/server/logs/audit.log
        - audit-policy-file=/var/lib/rancher/k3s/server/audit.yaml
        - audit-log-maxage=30
        - audit-log-maxbackup=10
        - audit-log-maxsize=100
        - admission-control-config-file=/var/lib/rancher/k3s/server/psa.yaml

  - path: /var/lib/rancher/k3s/server/audit.yaml
    permissions: "0600"
    content: |
      apiVersion: audit.k8s.io/v1
      kind: Policy
      rules:
        - level: Metadata

  # Pod security for every namespace without a label: restricted, with no
  # exemption. kube-system gets the baseline level by its own label below,
  # because its pods pass baseline and not restricted.
  - path: /var/lib/rancher/k3s/server/psa.yaml
    permissions: "0600"
    content: |
      apiVersion: apiserver.config.k8s.io/v1
      kind: AdmissionConfiguration
      plugins:
        - name: PodSecurity
          configuration:
            apiVersion: pod-security.admission.config.k8s.io/v1
            kind: PodSecurityConfiguration
            defaults:
              enforce: restricted
              enforce-version: latest
              audit: restricted
              audit-version: latest
              warn: restricted
              warn-version: latest
            exemptions:
              usernames: []
              runtimeClasses: []
              namespaces: []

  # The audit copier (ADR 0019): the files from platform/logs/ in the
  # repository, in base64 so that nothing in them is read as YAML or template.
  # First boot installs them once K3s has made /var/log/pods.
  - path: /usr/local/lib/aisec/install/aisec_audit_copy.py
    encoding: b64
    permissions: "0644"
    content: ${audit_copy_py}

  - path: /usr/local/lib/aisec/install/aisec-audit-copy.service
    encoding: b64
    permissions: "0644"
    content: ${audit_copy_unit}

  - path: /usr/local/lib/aisec/install/install-audit-copy.sh
    encoding: b64
    permissions: "0700"
    content: ${audit_copy_install}

  # The journal puller (ADR 0019), the same way. First boot makes its key. The
  # worker trusts it, and its host key is pinned, in a runbook step.
  - path: /usr/local/lib/aisec/install/aisec_journal_pull.py
    encoding: b64
    permissions: "0644"
    content: ${journal_pull_py}

  - path: /usr/local/lib/aisec/install/aisec-journal-pull.service
    encoding: b64
    permissions: "0644"
    content: ${journal_pull_unit}

  - path: /usr/local/lib/aisec/install/aisec-journal-pull.timer
    encoding: b64
    permissions: "0644"
    content: ${journal_pull_timer}

  - path: /usr/local/lib/aisec/install/install-journal-pull.sh
    encoding: b64
    permissions: "0700"
    content: ${journal_pull_install}

  - path: /usr/local/sbin/aisec-first-boot
    permissions: "0700"
    content: |
      #!/bin/bash
      set -euo pipefail

      # An empty revocation list. Without the file, sshd refuses every
      # certificate for the administrator account. Azure wrote the operator key
      # to the account's authorized_keys, which sshd ignores for it. The file
      # goes, so a key line there is a change to look at (A.5).
      ssh-keygen -q -k -f /etc/ssh/aisec-revoked.krl
      rm -f /home/${admin_username}/.ssh/authorized_keys
      sysctl --system >/dev/null
      systemctl daemon-reload
      systemctl enable --now aisec-pod-egress.service

      # Tighter modes on files an audit flagged, and no assembler or linker.
      chmod 600 /etc/crontab /etc/ssh/sshd_config
      chmod 700 /etc/cron.d /etc/cron.daily /etc/cron.hourly /etc/cron.weekly /etc/cron.monthly
      DEBIAN_FRONTEND=noninteractive apt-get remove -y -q -o DPkg::Lock::Timeout=120 binutils

      # K3s. The binary and the install script are both checked before either
      # runs. Both come through the edge, so a fetch window has to be open.
      proxy="http://${edge_ip}:3128"
      work="$(mktemp -d)"
      release="https://github.com/k3s-io/k3s/releases/download/${urlencode(k3s_version)}"
      curl -fsSL --proxy "$proxy" "$release/k3s" -o "$work/k3s"
      echo "${k3s_sha256}  $work/k3s" | sha256sum -c -
      curl -fsSL --proxy "$proxy" "https://raw.githubusercontent.com/k3s-io/k3s/${urlencode(k3s_version)}/install.sh" -o "$work/install.sh"
      echo "${k3s_install_sha256}  $work/install.sh" | sha256sum -c -

      install -d -m 0700 /var/lib/rancher/k3s/server/logs
      install -m 0755 "$work/k3s" /usr/local/bin/k3s
      # The install script writes the CONTAINERD_ variables to k3s.service.env.
      # They give containerd the proxy for image pulls, and leave K3s and the
      # kubelet without one.
      INSTALL_K3S_SKIP_DOWNLOAD=true INSTALL_K3S_VERSION='${k3s_version}' \
        CONTAINERD_HTTP_PROXY="$proxy" CONTAINERD_HTTPS_PROXY="$proxy" \
        CONTAINERD_NO_PROXY=localhost,127.0.0.0/8,10.0.0.0/8 \
        sh "$work/install.sh"
      rm -rf "$work"

      # Two settings the Kubernetes benchmark asks for and K3s does not ship.
      # The server is still starting here, so each patch is retried until the
      # API has created the namespace and its service account. A patch that
      # never succeeds stops the script, and the marker below is not written.
      retry() {
        for _ in $(seq 1 60); do
          "$@" && return 0
          sleep 5
        done
        return 1
      }
      for ns in default kube-system kube-public kube-node-lease; do
        retry k3s kubectl patch serviceaccount default -n "$ns" \
          -p '{"automountServiceAccountToken": false}'
      done
      # The system pods pass baseline: no privileged container, no host path,
      # no host network. A namespace without a label gets restricted instead.
      retry k3s kubectl label --overwrite namespace kube-system \
        pod-security.kubernetes.io/enforce=baseline \
        pod-security.kubernetes.io/enforce-version=latest
      chmod 600 /var/lib/rancher/k3s/server/tls/*.crt

      # The audit copier reads the pod logs, which exist once the kubelet runs.
      retry test -d /var/log/pods
      /usr/local/lib/aisec/install/install-audit-copy.sh
      /usr/local/lib/aisec/install/install-journal-pull.sh

      # The key the orchestrator uses to feed the other machines. It is made
      # here so the private half never passes through Terraform or its state.
      install -d -m 0700 -o ${admin_username} -g ${admin_username} /home/${admin_username}/.ssh
      sudo -u ${admin_username} ssh-keygen -q -t ed25519 -N "" -C aisec-feed \
        -f /home/${admin_username}/.ssh/aisec-feed

      touch /var/lib/aisec-first-boot.done

runcmd:
  - [/usr/local/sbin/aisec-first-boot]
