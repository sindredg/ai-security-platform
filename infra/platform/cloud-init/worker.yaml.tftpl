#cloud-config
# The AI worker has no internet access and no DNS, so nothing here installs or
# downloads anything. The orchestrator copies what it needs, and packages come
# through Squid on the edge.
write_files:
  - path: /etc/hosts
    append: true
    content: |
      ${orchestrator_ip} aisec-orchestrator tool-service.aisec.internal

  # Packages come through Squid on the edge. Unattended upgrades are on in the
  # image and use it too.
  - path: /etc/apt/apt.conf.d/90aisec-proxy
    permissions: "0644"
    content: |
      Acquire::http::Proxy "http://${edge_ip}:3128";

  # Hardening that an audit asked for and nothing here needs otherwise. What was
  # left alone, and why, is in the milestone 2 worklog.
  - path: /etc/sysctl.d/90-aisec-hardening.conf
    permissions: "0644"
    content: |
      kernel.sysrq = 0
      kernel.kptr_restrict = 2
      kernel.core_uses_pid = 1
      fs.suid_dumpable = 0
      fs.protected_fifos = 2
      fs.protected_regular = 2
      net.core.bpf_jit_harden = 2
      net.ipv4.conf.all.accept_source_route = 0
      net.ipv4.conf.default.accept_source_route = 0
      net.ipv4.conf.all.accept_redirects = 0
      net.ipv4.conf.default.accept_redirects = 0
      net.ipv4.conf.all.send_redirects = 0
      net.ipv4.conf.default.send_redirects = 0
      net.ipv4.conf.all.log_martians = 1
      net.ipv4.conf.default.log_martians = 1
      net.ipv6.conf.all.accept_redirects = 0
      net.ipv6.conf.default.accept_redirects = 0

  # Read before the image's own files, and the first value wins.
  - path: /etc/ssh/sshd_config.d/10-aisec.conf
    permissions: "0600"
    content: |
      PermitRootLogin no
      AllowAgentForwarding no
      AllowTcpForwarding no
      X11Forwarding no
      MaxAuthTries 3
      MaxSessions 2
      ClientAliveInterval 300
      ClientAliveCountMax 2
      TCPKeepAlive no
      LogLevel VERBOSE
      # The administrator account takes only a certificate signed by the
      # operator's certificate authority, for the principal in the file (ADR
      # 0022). A plain key, the operator's included, is refused. First boot
      # writes the empty revocation list. Other accounts keep their keys.
      Match User ${admin_username}
        AuthorizedKeysFile none
        TrustedUserCAKeys /etc/ssh/aisec-user-ca.pub
        AuthorizedPrincipalsFile /etc/ssh/aisec-principals
        RevokedKeys /etc/ssh/aisec-revoked.krl

  - path: /etc/ssh/aisec-user-ca.pub
    permissions: "0644"
    content: |
      ${operator_user_ca_public_key}

  - path: /etc/ssh/aisec-principals
    permissions: "0644"
    content: |
      aisec-operator

  # The account the orchestrator pulls this machine's journal through (ADR
  # 0019): the files from worker/log-export/ in the repository, in base64. The
  # orchestrator's key is added in a runbook step, once that key exists.
  - path: /usr/local/lib/aisec/install/aisec-journal-export
    encoding: b64
    permissions: "0755"
    content: ${log_export_command}

  - path: /usr/local/lib/aisec/install/install-log-export.sh
    encoding: b64
    permissions: "0700"
    content: ${log_export_install}

  # The account the orchestrator's feed key logs in to (ADR 0026). Its key is
  # added in a runbook step, as the log export key is.
  - path: /usr/local/lib/aisec/install/aisec-feed-receive
    encoding: b64
    permissions: "0755"
    content: ${feed_receive_command}

  - path: /usr/local/lib/aisec/install/install-feed-account.sh
    encoding: b64
    permissions: "0700"
    content: ${feed_receive_install}

  # The host audit (ADR 0054): the files from platform/host-audit/ in the
  # repository, in base64. First boot installs the audit daemon and AIDE from
  # them and writes the first baseline, after the two accounts above.

  - path: /usr/local/lib/aisec/install/host-audit/worker.rules
    encoding: b64
    permissions: "0644"
    content: ${host_audit_rules}

  - path: /usr/local/lib/aisec/install/host-audit/aisec-syslog.conf
    encoding: b64
    permissions: "0644"
    content: ${host_audit_plugin}

  - path: /usr/local/lib/aisec/install/host-audit/worker.aide.conf
    encoding: b64
    permissions: "0644"
    content: ${host_audit_aide_conf}

  - path: /usr/local/lib/aisec/install/host-audit/aisec-aide-check
    encoding: b64
    permissions: "0755"
    content: ${host_audit_check}

  - path: /usr/local/lib/aisec/install/host-audit/aisec-aide-baseline
    encoding: b64
    permissions: "0755"
    content: ${host_audit_baseline}

  - path: /usr/local/lib/aisec/install/host-audit/aisec-aide-check.service
    encoding: b64
    permissions: "0644"
    content: ${host_audit_service}

  - path: /usr/local/lib/aisec/install/host-audit/aisec-aide-check.timer
    encoding: b64
    permissions: "0644"
    content: ${host_audit_timer}

  - path: /usr/local/lib/aisec/install/host-audit/install-host-audit.sh
    encoding: b64
    permissions: "0700"
    content: ${host_audit_install}

  - path: /etc/modprobe.d/aisec-unused.conf
    permissions: "0644"
    content: |
      install dccp /bin/false
      install sctp /bin/false
      install rds /bin/false
      install tipc /bin/false
      install usb-storage /bin/false

# Tighter modes on files an audit flagged, and no assembler or linker. Removing
# a package needs no repository.
runcmd:
  # An empty revocation list. Without the file, sshd refuses every
  # certificate for the administrator account. Azure wrote the operator key
  # to the account's authorized_keys, which sshd ignores for it. The key
  # goes. cloud-init's final stage writes the file back empty, so a key
  # line there, not the file, is a change to look at (A.7).
  - [ssh-keygen, -q, -k, -f, /etc/ssh/aisec-revoked.krl]
  - [rm, -f, /home/${admin_username}/.ssh/authorized_keys]
  - [sysctl, --system]
  - [chmod, "600", /etc/crontab, /etc/ssh/sshd_config]
  - [chmod, "700", /etc/cron.d, /etc/cron.daily, /etc/cron.hourly, /etc/cron.weekly, /etc/cron.monthly]
  - [apt-get, remove, -y, -q, -o, "DPkg::Lock::Timeout=120", binutils]
  # Ubuntu's news, Pro status, and release checks ask Canonical's hosts for
  # data, and Squid refuses them. Masked units, and a login script that does
  # not run, instead of changed package configuration files. The timers stop
  # first: masking the service under a running timer leaves the timer failed.
  - [systemctl, stop, motd-news.timer, update-notifier-motd.timer]
  - [systemctl, mask, esm-cache.service, apt-news.service, motd-news.timer, motd-news.service, update-notifier-motd.timer, update-notifier-motd.service]
  # No message-of-the-day script runs at a login: PAM ran each of them as
  # root at every login, the journal pull's every five minutes included, and
  # the audit daemon recorded about forty programs a login (ADR 0054).
  - [sh, -c, "chmod 644 /etc/update-motd.d/*"]
  - [/usr/local/lib/aisec/install/install-log-export.sh]
  - [/usr/local/lib/aisec/install/install-feed-account.sh]
  # The audit daemon, with its records to syslog, and AIDE's first baseline
  # (ADR 0054). The model server and the agent runtime come later, from the
  # orchestrator, and their runbooks write a new baseline after them.
  - [/usr/local/lib/aisec/install/host-audit/install-host-audit.sh, worker]
